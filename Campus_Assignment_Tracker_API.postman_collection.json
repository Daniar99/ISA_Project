    "item": [
        {
            "name": "1. GET All Assignments (200 OK)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": "{{base_url}}/api/assignments"
            },
            "response": []
        },
        {
            "name": "2. GET Filter By Status (200 OK)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": "{{base_url}}/api/assignments?status=pending"
            },
            "response": []
        },
        {
            "name": "3. POST Validation Error Demo (422 Unprocessable Entity)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"description\": \"Missing required title, course_code, and due_date\"\n}"
                },
                "url": "{{base_url}}/api/assignments"
            },
            "response": []
        },
        {
            "name": "4. POST Create Assignment (201 Created)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"Cloud Computing Docker Project\",\n    \"course_code\": \"cs402\",\n    \"description\": \"Containerize a multi-tier Laravel and MySQL app.\",\n    \"due_date\": \"{{due_date}}\",\n    \"priority\": \"high\",\n    \"status\": \"pending\"\n}"
                },
                "url": "{{base_url}}/api/assignments"
            },
            "response": [],
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const date = new Date();",
                            "date.setDate(date.getDate() + 7);",
                            "pm.collectionVariables.set('due_date', date.toISOString().slice(0, 10));"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "if (pm.response.code === 201) {",
                            "    pm.collectionVariables.set('assignment_id', pm.response.json().data.id);",
                            "}"
                        ]
                    }
                }
            ]
        },
        {
            "name": "5. GET Show Single Assignment (200 OK)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": "{{base_url}}/api/assignments/{{assignment_id}}"
            },
            "response": []
        },
        {
            "name": "6. GET Non-Existent Assignment (404 Not Found)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": "{{base_url}}/api/assignments/9999"
            },
            "response": []
        },
        {
            "name": "7. PATCH Partial Update (200 OK)",
            "request": {
                "method": "PATCH",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"status\": \"graded\",\n    \"grade\": 98\n}"
                },
                "url": "{{base_url}}/api/assignments/{{assignment_id}}"
            },
            "response": []
        },
        {
            "name": "8. DELETE Assignment (204 No Content)",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "url": "{{base_url}}/api/assignments/{{assignment_id}}"
            },
            "response": []
        }
    ],
